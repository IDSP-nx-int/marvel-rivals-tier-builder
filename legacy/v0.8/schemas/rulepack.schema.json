{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/mr/v0.8/rulepack.schema.json",
  "title": "MR v0.8 Rulepack",
  "$comment": "Identifiers and foreign keys validated by tools/validate.py; format checks enabled.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "kind": {
      "const": "rulepack"
    },
    "schemaVersion": {
      "const": "0.8.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "patchId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "resourcePools": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
          },
          "providerHeroId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
          },
          "capacity": {
            "type": "integer",
            "minimum": 0
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "supportedWindows": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
            },
            "minItems": 1
          }
        },
        "required": [
          "id",
          "providerHeroId",
          "capacity",
          "unit",
          "supportedWindows"
        ]
      }
    },
    "interactionRules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
          },
          "scope": {
            "enum": [
              "composition",
              "matchup"
            ]
          },
          "kind": {
            "enum": [
              "capability-chain",
              "counter-check"
            ]
          },
          "requirements": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "capabilityId": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
                },
                "minScore": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 5
                }
              },
              "required": [
                "capabilityId",
                "minScore"
              ]
            },
            "minItems": 1
          },
          "requiresSameWindow": {
            "type": "boolean"
          },
          "requiresCompatibleTarget": {
            "type": "boolean"
          },
          "result": {
            "enum": [
              "win-condition-candidate",
              "contested",
              "resource-check",
              "coverage-candidate"
            ]
          },
          "mechanismId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "scope",
          "kind",
          "requirements",
          "requiresSameWindow",
          "requiresCompatibleTarget",
          "result",
          "description"
        ]
      }
    }
  },
  "required": [
    "kind",
    "schemaVersion",
    "id",
    "patchId",
    "version",
    "resourcePools",
    "interactionRules"
  ]
}
