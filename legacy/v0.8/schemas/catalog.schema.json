{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/mr/v0.8/catalog.schema.json",
  "title": "MR v0.8 Catalog",
  "$comment": "Identifiers and foreign keys validated by tools/validate.py; format checks enabled.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "kind": {
      "const": "catalog"
    },
    "schemaVersion": {
      "const": "0.8.0"
    },
    "patch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "fictional-demo",
            "curated",
            "draft"
          ]
        },
        "publishedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "label",
        "status"
      ]
    },
    "heroes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "enum": [
              "vanguard",
              "duelist",
              "strategist"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "category"
        ]
      },
      "minItems": 1
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "family": {
            "enum": [
              "pressure",
              "space",
              "response",
              "enablement",
              "continuity"
            ]
          },
          "definition": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "label",
          "family",
          "definition"
        ]
      },
      "minItems": 1
    },
    "vulnerabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "label",
          "description"
        ]
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "label",
          "description"
        ]
      }
    },
    "subroles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "enum": [
              "vanguard",
              "duelist",
              "strategist"
            ]
          },
          "coreCapabilities": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "suggestedVulnerabilities": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
            }
          },
          "suggestedDependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
            }
          }
        },
        "required": [
          "id",
          "label",
          "category",
          "coreCapabilities",
          "suggestedVulnerabilities",
          "suggestedDependencies"
        ]
      },
      "minItems": 9,
      "maxItems": 9
    },
    "mechanisms": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "label",
          "description"
        ]
      }
    }
  },
  "required": [
    "kind",
    "schemaVersion",
    "patch",
    "heroes",
    "capabilities",
    "vulnerabilities",
    "dependencies",
    "subroles",
    "mechanisms"
  ]
}
